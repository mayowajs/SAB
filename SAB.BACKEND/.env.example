# Use MongoDB Atlas or a local MongoDB replica set for atomic transfers.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sab?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
NODE_ENV=development